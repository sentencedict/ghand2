{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghand2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3b86335e-3cc2-4419-a5fb-be602c3371c2","database_name": "web-app2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bad607bfe1cf4557bab701395ae8438e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
